# Másold .env.local néven, és töltsd ki. Soha ne commitold a valódi kulcsokat!

# Alaptérkép stílus (MapLibre style JSON URL). Alapértelmezés: OpenFreeMap Positron (ingyenes, kulcs nélkül).
VITE_BASEMAP_STYLE=https://tiles.openfreemap.org/styles/positron

# Google Maps Platform kulcs a fotorealisztikus 3D nézethez (Maps JavaScript API, maps3d könyvtár;
# ha a konzol kéri, a Map Tiles API-t is engedélyezd). Korlátozd HTTP-referrerre!
# Üresen hagyva a Google 3D nézet kikapcsolt, a MapLibre-alapú 3D működik.
VITE_GOOGLE_MAPS_API_KEY=

# Opcionális Google Map ID (vektoros / 3D térképstílushoz)
VITE_GOOGLE_MAP_ID=

# Későbbi Supabase/PostGIS háttér (jelenleg nincs használatban, a prototípus helyi tárolót használ)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
