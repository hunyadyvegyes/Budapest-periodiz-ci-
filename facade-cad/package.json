{
  "name": "facade-cad",
  "version": "0.1.0",
  "description": "Facade photo to 2D architectural CAD elevation (DXF/SVG/PDF) – browser-based MVP",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:samples": "python3 scripts/make_samples.py",
    "eval": "vite-node scripts/evaluate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.2"
  }
}
